# Copy to .env and fill in. .env is git-ignored.

# memory:// for local single-process runs, or redis://localhost:6379/0 to share
# locks, processed-file history and run records between workers.
ETL_STATE_URL=memory://

ETL_DB_PATH=output/warehouse.db
ETL_REJECTS_DIR=output/rejects
ETL_PIPELINES_DIR=pipelines
# The API only ingests files from inside this folder.
ETL_INBOX_DIR=sample_data

# Required for the API and for issuing tokens. 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ETL_JWT_SECRET=
# Optional: when set, tokens must carry this iss / aud.
ETL_JWT_ISSUER=
ETL_JWT_AUDIENCE=
